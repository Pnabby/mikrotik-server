# Shared RouterOS API credentials. Keep the real values only in .env or the service environment.
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=

# Shared RouterOS transport settings.
MIKROTIK_PLAINTEXT_LOGIN=true
MIKROTIK_USE_SSL=false
MIKROTIK_SSL_VERIFY=true
MIKROTIK_SSL_VERIFY_HOSTNAME=true

# Interactive CLI router selection only: flint-main or platinum.
MIKROTIK_ROUTER_ID=flint-main

# FastAPI server settings.
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_CORS_ORIGINS=*
