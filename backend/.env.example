# FastAPI server settings.
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173
# FRONTEND_DIST_DIR may override the default public/dist with an absolute path.

# PostgreSQL SQLAlchemy URL. Required only when database-backed features or Alembic run.
# Example shape: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Brevo transactional email and email-only OTP settings.
# Create a Brevo API v3 key and use a sender address verified in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Flint WiFi
# Generate a separate random secret, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
OTP_HASH_SECRET=
OTP_CODE_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
# Use another independently generated secret to protect low-entropy customer PIN hashes.
PIN_HASH_SECRET=
CUSTOMER_SESSION_TTL_SECONDS=604800
# Admin sessions default to 12 hours.
ADMIN_SESSION_TTL_SECONDS=43200

# Shared RouterOS API credentials and transport settings.
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
MIKROTIK_PLAINTEXT_LOGIN=true
MIKROTIK_USE_SSL=false
MIKROTIK_SSL_VERIFY=true
MIKROTIK_SSL_VERIFY_HOSTNAME=true
MIKROTIK_ROUTER_ID=flint-main
MIKROTIK_REGISTRATION_PROFILE=disabled

# Optional legacy one-time import input. Runtime router selection uses the routers table.
# Each item requires: router_id, name, host, port, and hotspot_network.
MIKROTIK_ROUTERS_JSON=[]

# Reserved for the future Paystack adapter; no payment behavior is enabled yet.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
